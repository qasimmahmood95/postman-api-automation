{
  "name": "postman-api-automation",
  "version": "1.0.0",
  "description": "Production-grade API test automation for the Restful Booker API using Postman and Newman",
  "private": true,
  "scripts": {
    "test": "newman run collections/restful-booker.postman_collection.json -e environments/production.postman_environment.json --reporters cli",
    "test:local": "newman run collections/restful-booker.postman_collection.json -e environments/local.postman_environment.json --reporters cli",
    "test:data": "newman run collections/restful-booker.postman_collection.json -e environments/production.postman_environment.json -d data/booking-test-data.json --reporters cli",
    "test:report": "newman run collections/restful-booker.postman_collection.json -e environments/production.postman_environment.json --reporters cli,htmlextra,junit --reporter-htmlextra-export reports/html/index.html --reporter-junit-export reports/junit/results.xml",
    "test:smoke": "newman run collections/restful-booker.postman_collection.json -e environments/production.postman_environment.json --folder \"Health Check\" --reporters cli"
  },
  "keywords": [
    "postman",
    "newman",
    "api-testing",
    "test-automation",
    "restful-booker",
    "sdet",
    "ci-cd"
  ],
  "author": "Qasim Mahmood",
  "license": "MIT",
  "devDependencies": {
    "newman": "^6.2.1",
    "newman-reporter-htmlextra": "^1.23.1"
  }
}
