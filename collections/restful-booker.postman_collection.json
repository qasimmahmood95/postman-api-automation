				{
					"name": "Partial Update Booking (PATCH)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"id": "e3c4d5e6-f7a8-4b90-8c1d-2e3f4a5b6c7d",
								"exec": [
									"// Patch only the price; everything else must remain untouched.",
									"const patchedPrice = Number(pm.collectionVariables.get(\"bookingTotalPrice\")) + 1;",
									"pm.collectionVariables.set(\"bookingTotalPrice\", patchedPrice);"
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"id": "0302d620-a147-41a8-8b5c-43b6640dcf10",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Content-Type is application/json\", function () {",
									"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
									"});",
									"",
									"pm.test(\"Patched price matches the value that was sent\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.totalprice).to.eql(Number(pm.collectionVariables.get(\"bookingTotalPrice\")));",
									"});",
									"",
									"pm.test(\"Fields not included in the patch are unchanged\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(String(jsonData.firstname)).to.eql(String(pm.collectionVariables.get(\"bookingFirstname\")));",
									"    pm.expect(String(jsonData.lastname)).to.eql(String(pm.collectionVariables.get(\"bookingLastname\")));",
									"    pm.expect(jsonData.additionalneeds).to.eql(pm.collectionVariables.get(\"bookingAdditionalNeeds\"));",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
