									"});",
									"",
									"pm.test(\"Token is a non-empty string and is stored for authenticated requests\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.token).to.be.a(\"string\").and.to.have.length.above(0);",
									"    pm.collectionVariables.set(\"token\", jsonData.token);",
									"});"
								],
