		{
			"name": "Booking CRUD",
			"item": [
				{
					"name": "Create Booking with Dynamic Test Data",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"id": "c1a2b3c4-d5e6-4f70-8a9b-0c1d2e3f4a5b",
								"exec": [
									"// Prefer data-driven values from newman iteration data (-d data.json);",
									"// fall back to Postman dynamic variables / computed values so the",
									"// collection also runs standalone with no data file. An explicit",
									"// undefined/null check (not ||) keeps falsy boundary values like",
									"// totalprice 0 or an empty additionalneeds string intact.",
									"const fromData = (key, fallback) => {",
									"    const value = pm.iterationData.get(key);",
									"    return (value === undefined || value === null) ? fallback : value;",
									"};",
									"",
									"const firstname = fromData(\"firstname\", pm.variables.replaceIn(\"{{$randomFirstName}}\"));",
									"const lastname = fromData(\"lastname\", pm.variables.replaceIn(\"{{$randomLastName}}\"));",
									"const totalprice = fromData(\"totalprice\", Math.floor(Math.random() * 900) + 100);",
									"const depositpaid = String(fromData(\"depositpaid\", true)) === \"true\";",
									"",
									"// Check-in a week from now, check-out two weeks from now (ISO yyyy-mm-dd).",
									"const dayMs = 24 * 60 * 60 * 1000;",
									"const toIsoDate = (d) => d.toISOString().split(\"T\")[0];",
									"const checkin = fromData(\"checkin\", toIsoDate(new Date(Date.now() + 7 * dayMs)));",
									"const checkout = fromData(\"checkout\", toIsoDate(new Date(Date.now() + 14 * dayMs)));",
									"const additionalneeds = fromData(\"additionalneeds\", \"Breakfast\");",
									"",
									"pm.collectionVariables.set(\"bookingFirstname\", firstname);",
									"pm.collectionVariables.set(\"bookingLastname\", lastname);",
									"pm.collectionVariables.set(\"bookingTotalPrice\", totalprice);",
									"pm.collectionVariables.set(\"bookingDepositPaid\", depositpaid);",
									"pm.collectionVariables.set(\"bookingCheckin\", checkin);",
									"pm.collectionVariables.set(\"bookingCheckout\", checkout);",
									"pm.collectionVariables.set(\"bookingAdditionalNeeds\", additionalneeds);"
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"id": "59a707d4-90c9-4e55-9781-e161dbed0c89",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Content-Type is application/json\", function () {",
									"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
									"});",
									"",
									"pm.test(\"Response matches create-booking schema\", function () {",
									"    pm.response.to.have.jsonSchema({",
									"        type: \"object\",",
									"        required: [\"bookingid\", \"booking\"],",
									"        properties: {",
									"            bookingid: { type: \"integer\" },",
									"            booking: {",
									"                type: \"object\",",
									"                required: [\"firstname\", \"lastname\", \"totalprice\", \"depositpaid\", \"bookingdates\"],",
									"                properties: {",
									"                    firstname: { type: \"string\" },",
									"                    lastname: { type: \"string\" },",
									"                    totalprice: { type: \"number\" },",
									"                    depositpaid: { type: \"boolean\" },",
									"                    bookingdates: {",
									"                        type: \"object\",",
									"                        required: [\"checkin\", \"checkout\"],",
									"                        properties: {",
									"                            checkin: { type: \"string\", format: \"date\" },",
									"                            checkout: { type: \"string\", format: \"date\" }",
									"                        }",
									"                    },",
									"                    additionalneeds: { type: \"string\" }",
									"                }",
									"            }",
									"        }",
									"    });",
									"});",
									"",
									"pm.test(\"Created booking echoes the generated test data\", function () {",
									"    var booking = pm.response.json().booking;",
									"    pm.expect(String(booking.firstname)).to.eql(String(pm.collectionVariables.get(\"bookingFirstname\")));",
									"    pm.expect(String(booking.lastname)).to.eql(String(pm.collectionVariables.get(\"bookingLastname\")));",
									"    pm.expect(booking.totalprice).to.eql(Number(pm.collectionVariables.get(\"bookingTotalPrice\")));",
									"    // Collection variables stringify on set, so compare against the \"true\"/\"false\" string form.",
									"    pm.expect(booking.depositpaid).to.eql(String(pm.collectionVariables.get(\"bookingDepositPaid\")) === \"true\");",
									"    pm.expect(booking.bookingdates.checkin).to.eql(pm.collectionVariables.get(\"bookingCheckin\"));",
									"    pm.expect(booking.bookingdates.checkout).to.eql(pm.collectionVariables.get(\"bookingCheckout\"));",
									"});",
									"",
									"pm.test(\"Booking ID is a number and is stored for downstream requests\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.bookingid).to.be.a(\"number\");",
									"    pm.collectionVariables.set(\"bookingId\", jsonData.bookingid);",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"id": "72779193-135c-4913-8279-2db1b69fe27a",
					"protocolProfileBehavior": {
						"disableBodyPruning": true
					},
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstname\": \"{{bookingFirstname}}\",\n    \"lastname\": \"{{bookingLastname}}\",\n    \"totalprice\": {{bookingTotalPrice}},\n    \"depositpaid\": {{bookingDepositPaid}},\n    \"bookingdates\": {\n        \"checkin\": \"{{bookingCheckin}}\",\n        \"checkout\": \"{{bookingCheckout}}\"\n    },\n    \"additionalneeds\": \"{{bookingAdditionalNeeds}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": "{{baseUrl}}/booking",
						"description": "Verifies a booking can be created from dynamically generated (or iteration-data-driven) test data and that the response echoes it back with a numeric booking ID."
					},
					"response": []
				},
				{
