									"",
									"pm.test(\"Content-Type is application/json\", function () {",
									"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
									"});",
									"",
									"pm.test(\"Response matches booking-id list schema\", function () {",
									"    pm.response.to.have.jsonSchema({",
									"        type: \"array\",",
									"        items: {",
									"            type: \"object\",",
									"            required: [\"bookingid\"],",
									"            properties: {",
									"                bookingid: { type: \"integer\" }",
									"            }",
									"        }",
									"    });",
									"});",
									"",
									"pm.test(\"Booking list is non-empty and contains the newly created booking\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an(\"array\").that.is.not.empty;",
									"    var ids = jsonData.map(b => b.bookingid);",
									"    pm.expect(ids).to.include(Number(pm.collectionVariables.get(\"bookingId\")));",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"id": "41177cde-ea30-4c25-ba9b-7213b96ab2a4",
					"protocolProfileBehavior": {
