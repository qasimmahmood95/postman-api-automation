				{
					"name": "Update Booking (Full PUT)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"id": "d2b3c4d5-e6f7-4a80-9b0c-1d2e3f4a5b6c",
								"exec": [
									"// Full update: raise the price and change the additional needs,",
									"// keeping the guest identity and dates generated at creation.",
									"const updatedPrice = Number(pm.collectionVariables.get(\"bookingTotalPrice\")) + 50;",
									"pm.collectionVariables.set(\"bookingTotalPrice\", updatedPrice);",
									"pm.collectionVariables.set(\"bookingAdditionalNeeds\", \"Late Checkout\");"
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"id": "3668db81-a6e7-44aa-bb95-3fb18c9a01b3",
								"exec": [
									"pm.test(\"Status code is 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Content-Type is application/json\", function () {",
									"    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
									"});",
									"",
									"pm.test(\"Updated fields reflect the values that were sent\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.totalprice).to.eql(Number(pm.collectionVariables.get(\"bookingTotalPrice\")));",
									"    pm.expect(jsonData.additionalneeds).to.eql(pm.collectionVariables.get(\"bookingAdditionalNeeds\"));",
									"});",
									"",
									"pm.test(\"Unchanged fields are preserved\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(String(jsonData.firstname)).to.eql(String(pm.collectionVariables.get(\"bookingFirstname\")));",
									"    pm.expect(String(jsonData.lastname)).to.eql(String(pm.collectionVariables.get(\"bookingLastname\")));",
									"    pm.expect(jsonData.bookingdates.checkin).to.eql(pm.collectionVariables.get(\"bookingCheckin\"));",
									"    pm.expect(jsonData.bookingdates.checkout).to.eql(pm.collectionVariables.get(\"bookingCheckout\"));",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
